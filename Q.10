#include <stdio.h>
float calcularTotal(float vendas[], int dias) {
    float soma = 0;
    int cont;
    for (cont=0 ; cont<dias ; cont++) {
        soma = soma + vendas[cont];
    }
    return soma;
}
float calcularMedia(float total, int dias) {
    return total / dias;
}
int contarVendasAcimaDaMedia(float vendas[], int dias, float media) {
    int cont, acima = 0;
    for (cont=0 ; cont<dias ; cont++) {
        if (vendas[cont] > media) {
            acima++;
        }
    }
    return acima;
}
int main() {
    float vendas[5], total, media;
    int cont, diasAcima;
    for (cont=0 ; cont<5 ; cont++) {
        printf("digite o valor da venda do dia %d :", cont+1);
        scanf("%f", &vendas[cont]);
    }
    total = calcularTotal(vendas, 5);
    media = calcularMedia(total, 5);
    diasAcima = contarVendasAcimaDaMedia(vendas, 5, media);
    printf("total vendido: %.2f\n", total);
    printf("media diaria: %.2f\n", media);
    printf("dias acima da media: %d\n", diasAcima);
}
